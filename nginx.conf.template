# Modele traite par `envsubst` au demarrage du conteneur nginx (mecanisme
# integre a l'image officielle, voir /docker-entrypoint.d/) : ${API_UPSTREAM},
# ${MINIO_UPSTREAM}, ${PROXY_SSL_VERIFY} et ${PROXY_SSL_CA_FILE} sont remplaces
# par la valeur des variables d'environnement du meme nom avant que nginx ne
# charge la configuration. Toutes ont un defaut dans le Dockerfile : une
# variable non definie deviendrait la chaine vide, et une directive vide est
# une erreur de syntaxe qui empeche nginx de demarrer.
# Sans danger pour les variables nginx ($http_host, $scheme...) : envsubst ne
# touche que les noms qui existent reellement comme variables d'environnement
# du conteneur, ce qui exclut celles-la.

# Requis pour relayer les WebSocket : "upgrade" seulement quand le client le
# demande, "close" sinon.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # Les pochettes et surtout les fichiers audio sont volumineux.
    client_max_body_size 1m;
    proxy_http_version 1.1;

    # Upstreams joints en https — typiquement MinIO, sur un reseau ou tout est
    # chiffre. nginx ne verifie RIEN par defaut (`proxy_ssl_verify off`) : on
    # conserve ce defaut, qui n'a aucun effet tant que les upstreams sont en
    # clair, mais l'activation ne demande plus de reconstruire l'image.
    # En airgap : PROXY_SSL_VERIFY=on et PROXY_SSL_CA_FILE=<autorite maison>,
    # montee dans ce conteneur.
    proxy_ssl_server_name on;
    proxy_ssl_verify ${PROXY_SSL_VERIFY};
    proxy_ssl_trusted_certificate ${PROXY_SSL_CA_FILE};

    # API.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;
        # Le front est aussi un snapclient : /api/snapcast/stream est une
        # WebSocket, qui exige la negociation d'upgrade.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MinIO, expose sous /s3 pour rester sur la meme origine que le front
    # (donc aucun CORS) sans publier MinIO directement sur le reseau.
    #
    # Le prefixe /s3 est retire ici car la signature SigV4 calculee par l'API
    # porte sur le chemin SANS prefixe (voir services/s3.public_stream_url).
    # `Host $http_host` transmet le port en plus du nom d'hote : il doit
    # correspondre exactement a S3_PUBLIC_BASE_URL, sans quoi MinIO rejette la
    # signature.
    location /s3/ {
        rewrite ^/s3/(.*)$ /$1 break;
        proxy_pass ${MINIO_UPSTREAM};
        proxy_set_header Host $http_host;

        # Streaming audio : on relaie les octets au fil de l'eau plutot que de
        # bufferiser le morceau entier, et on laisse passer les requetes Range.
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Sonde, pour l'image comme pour les orchestrateurs : elle sert de
    # vivacite et de disponibilite a la fois, nginx n'ayant rien a preparer
    # avant de servir des fichiers deja presents dans l'image.
    #
    # Volontairement sans le moindre upstream : lier l'etat du front a celui
    # de l'API ferait retirer l'interface du service a chaque panne de l'API,
    # alors qu'elle sait justement afficher l'erreur. La cascade rendrait la
    # panne muette au lieu de la rendre lisible.
    #
    # `access_log off` : interrogee toutes les dix secondes, elle noierait
    # sinon les journaux d'acces.
    location = /healthz {
        access_log off;
        # Sans cela nginx sert ce texte en application/octet-stream, ce qui
        # fait proposer un telechargement a qui l'ouvre dans un navigateur.
        default_type text/plain;
        return 200 "ok\n";
    }

    # Application React (routage cote client).
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    # Les assets Vite portent un hash dans leur nom : cache agressif possible.
    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
